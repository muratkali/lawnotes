#!/usr/bin/env python3
"""lawnotes: open the Law Notes editor.

    lawnotes [note]            open Law Notes; inside herdr in a "Notes" tab, otherwise here
    lawnotes --window [note]   in the dedicated Law Notes window (what the app does)
    lawnotes --split [note]    in a new herdr pane beside this one
    lawnotes --here [note]     in this terminal
    lawnotes --update          install the newest signed release now
    lawnotes --rollback        go back to the previous version
    lawnotes --export NOTE docx|pdf   export a note to Word or PDF (into Downloads)
    lawnotes --abbreviations   edit your abbreviations (CL = Common Law, …)
    lawnotes --version         show the installed version
    lawnotes --uninstall       remove Law Notes (your notes stay)

A note is a name inside the notes folder (Tort/Duty) or a file path. If Law Notes is
already open, the launcher brings that copy forward (and opens the note there) instead
of starting a second one, so the same note is never edited in two places.
"""
import json
import os
import shlex
import shutil
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
EDITOR = os.path.join(HERE, "lawnotes.py")
UPDATER = os.path.join(HERE, "update.py")
INSTALLED = os.path.basename(os.path.dirname(HERE)) == "versions"  # vs a development checkout
ROOT = os.path.dirname(os.path.dirname(HERE)) if INSTALLED else None
CACHE = os.path.expanduser("~/.cache/lawnotes")
RUNNING = os.path.join(CACHE, "running.json")
REQUEST = os.path.join(CACHE, "open-request.json")


def herdr(*args):
    """Run a herdr command: its JSON result, {} for success without output, or None on failure."""
    if not shutil.which("herdr"):
        return None
    try:
        r = subprocess.run(["herdr", *args], capture_output=True, text=True, timeout=15)
        if r.returncode != 0:
            return None
        return json.loads(r.stdout)["result"] if r.stdout.strip() else {}  # `pane run` prints nothing
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        return None


def running():
    """Details of the Law Notes copy that's open on this Mac, if any."""
    try:
        with open(RUNNING) as f:
            info = json.load(f)
        os.kill(info["pid"], 0)
        cmd = subprocess.run(["ps", "-p", str(info["pid"]), "-o", "command="],
                             capture_output=True, text=True).stdout
        return info if "lawnotes.py" in cmd else None
    except (OSError, ValueError, KeyError):
        return None


def request(note):
    """Ask the open (or about to open) editor to open this note."""
    if not note:
        return
    if os.path.exists(note):  # a real file: make it absolute before the cwd changes
        note = os.path.abspath(note)
    os.makedirs(CACHE, exist_ok=True)
    with open(REQUEST + ".tmp", "w") as f:
        json.dump({"note": note, "time": time.time()}, f)
    os.replace(REQUEST + ".tmp", REQUEST)


def bring_forward(info, from_app):
    pane = herdr("pane", "get", info["pane"]) if info.get("pane") else None
    if pane:
        herdr("tab", "focus", pane["pane"]["tab_id"])
        where = "its herdr tab"
    else:
        where = "its Terminal window"
    if from_app or not pane:
        subprocess.run(["open", "-a", "Terminal"])
    print(f"Law Notes is already open — switched to {where}.")


def editor_command(note):
    parts = [sys.executable, EDITOR] + ([note] if note else [])
    return " ".join(shlex.quote(p) for p in parts) + " || read -r -p 'Press Enter to close. '; exit"


def open_tab(note):
    """A herdr tab called Notes in the current workspace."""
    me = herdr("pane", "get", os.environ["HERDR_PANE_ID"])
    if not me:
        return False
    tab = herdr("tab", "create", "--workspace", me["pane"]["workspace_id"], "--label", "Notes",
                "--focus", "--cwd", os.path.expanduser("~"))
    if not tab:
        return False
    return herdr("pane", "run", tab["root_pane"]["pane_id"], editor_command(note)) is not None


def open_split(note):
    new = herdr("pane", "split", os.environ["HERDR_PANE_ID"], "--direction", "right", "--ratio", "0.5",
                "--focus", "--cwd", os.path.expanduser("~"))
    return bool(new) and herdr("pane", "run", new["pane"]["pane_id"], editor_command(note)) is not None


def open_window(note):
    """The dedicated window: Terminal with the Law Notes profile (dark red, sized for prose)."""
    profile = os.path.join(ROOT, "Law Notes.terminal") if ROOT else None
    if not profile or not os.path.exists(profile):
        return False
    request(note)  # picked up by the editor as it starts
    return subprocess.run(["open", profile]).returncode == 0


def background_update():
    if INSTALLED and not os.environ.get("LAWNOTES_NO_UPDATE"):
        subprocess.Popen([sys.executable, UPDATER, "--daily"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def main():
    args = sys.argv[1:]
    flag = args[0] if args and args[0].startswith("-") else None
    note = next((a for a in args if not a.startswith("-")), None)

    if flag in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if flag in ("-V", "--version"):
        version = subprocess.run([sys.executable, EDITOR, "--version"], capture_output=True, text=True).stdout.strip()
        print(version + ("" if INSTALLED else f" (development copy in {HERE})"))
        return 0
    if flag in ("--update", "--rollback", "--uninstall"):
        if not INSTALLED:
            print("This is a development copy; install Law Notes to update it.", file=sys.stderr)
            return 1
        return subprocess.run([sys.executable, UPDATER, {"--update": "--now"}.get(flag, flag)]).returncode
    if flag in ("--self-test", "--export"):
        return subprocess.run([sys.executable, EDITOR] + args).returncode

    if flag == "--abbreviations":  # open the abbreviations file like a note
        notes = os.path.expanduser(os.environ.get("LAWNOTES_DIR", "~/UCL/notes"))
        note = os.path.join(notes, ".abbreviations.txt")
        if not os.path.exists(note):
            os.makedirs(notes, exist_ok=True)
            with open(note, "w") as f:
                f.write("# Abbreviations: they expand when you finish the word (space, punctuation, Enter).\n"
                        "# One per line: SHORT = Long form. Exact case; whole words only.\n"
                        "CL = Common Law\nEL = Equity Law\nLCh = Lord Chancellor\n")
        flag = None
    in_herdr = bool(os.environ.get("HERDR_PANE_ID")) and shutil.which("herdr")
    mode = {"--window": "window", "--app": "window", "--split": "split", "--here": "here"}.get(
        flag, "tab" if in_herdr else "here")
    background_update()

    if mode != "here":
        info = running()
        if info:
            request(note)
            bring_forward(info, from_app=flag == "--app")
            return 0
        opened = {"window": open_window, "tab": open_tab, "split": open_split}[mode](note) if (
            mode == "window" or in_herdr) else False
        if opened:
            return 0
        if flag == "--app":  # no profile (development copy): a plain Terminal window
            return subprocess.run(["open", "-a", "Terminal", EDITOR]).returncode
    os.execv(sys.executable, [sys.executable, EDITOR] + ([note] if note else []))


if __name__ == "__main__":
    sys.exit(main())
